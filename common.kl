let append xs ys =
  match xs {
    [] =>
      ys;
    x :: rest =>
      x :: (append rest ys);
  };

let map f xs =
  match xs {
    [] =>
      [];
    x :: rest =>
      (f x) :: map f rest;
  };

let fst xs =
  match xs {
    [] =>
      -1;
    x :: rest =>
      x;
  };

let reverse xs =
  match xs {
    [] =>
      [];
    x :: rest =>
      append (reverse rest) [x];
  };
  
let last xs =
  fst (reverse xs);

let init xs =
  match (reverse xs) {
    x :: rest =>
      reverse rest;
  };

let not b =
  if b then
    false
  else
    true;
    
let all bs =
  match bs {
    [] =>
      true;
    b :: rest =>
      if not b then
        false
      else
        all rest;
  };

let any bs =
  match bs {
    [] =>
      false;
    b :: rest =>
      if b then
        true
      else
        any rest;
  };

let length xs =
  match xs {
    [] =>
      0;
    _ :: rest =>
      1 + length rest;
  };

let zip xs ys =
  match xs, ys {
    x :: xrest, y :: yrest =>
      [x, y] :: zip xrest yrest;
    _, _ =>
      [];
  };

let isIn xs v =
  match xs {
    [] =>
      false;
    x :: rest =>
      if x == v then
        true
      else
        isIn rest v;
  };

let dedup xs =
  let loop ys seen =
    match ys {
      [] =>
        seen;
      y :: rest =>
        if isIn seen y then
          loop rest seen
        else
          loop rest (append seen [y]);
    }
    in
  loop xs [];

let isDistinct xs =
  length (dedup xs) == length xs;
