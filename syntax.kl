type Parser a
  = Failed 
  | Parsed a String;

type alias Binding =
  {name: String, typ: Type};

type alias FieldType =
  {name: String, typ: Type};

type Type
  = NumberType
  | BoolType
  | StringType
  | NullType
  | FnType [Type] Type
  | RecordType [FieldType];

type Op
  = NegateOp
  | NotOp
  | AddOp
  | SubOp
  | MulOp
  | DivOp
  | ConcatOp
  | LtOp
  | LteOp
  | GtOp
  | GteOp
  | EqOp
  | NotEqOp
  | AndOp
  | OrOp;

type alias FieldExpr =
  {name: String, expr: Expr};
  
type Expr
  = NumberExpr Float
  | BoolExpr Bool
  | StringExpr String
  | NullExpr
  | VarExpr String
  | AssignExpr String Expr
  | BinExpr Op Expr Expr
  | UnaryExpr Op Expr
  | FnExpr [Binding] Type Expr
  | AppExpr Expr Expr
  | RecordExpr [FieldExpr]
  | FieldAccessExpr Expr String
  | LetExpr String (Option Type) Expr
  | IfExpr Bool Expr Expr
  | While Bool Expr;