type Parser a
  = Failed 
  | Parsed a String;

type alias Binding 
  = {name: String, typ: Type};

type alias BindingExpr
  = {name: String, expr: Expr};

type Type
  = NumberType
  | BoolType
  | StringType
  | NullType
  | FnType [Type] Type
  | RecordType [Binding];

type Op
  = NegateOp
  | NotOp
  | AddOp
  | SubOp
  | MulOp
  | DivOp
  | ConcatOp
  | LtOp
  | LteOp
  | GtOp
  | GteOp
  | EqOp
  | NotEqOp
  | AndOp
  | OrOp;

type Expr
  = NumberExpr Float
  | BoolExpr Bool
  | StringExpr String
  | VarExpr String
  | NullExpr
  | FnExpr [Binding] Type Expr
  | RecordExpr [BindingExpr]
  | LetExpr String (Option Type) Expr
  | IfExpr Bool Expr Expr
  | While Bool Expr
  | AssignExpr String Expr
  | BinExpr Op Expr Expr
  | UnaryExpr Op Expr;