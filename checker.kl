include "common.kl";

type alias Binding =
  {name: String, typ: Type};

type alias FieldType =
  {name: String, typ: Type};

type Type
  = NumberType
  | BoolType
  | StringType
  | NullType
  | FnType [Type] Type
  | RecordType [FieldType];

let typePairEquals pair =
  typeEquals (fst pair) (last pair);
  
let typeEquals left right =
  match left, right {
    NumberType, NumberType =>
      true;
    BoolType, BoolType =>
      true;
    StringType, StringType =>
      true;
    NullType, NullType =>
      true;
    FnType ps1 ret1, FnType ps2 ret2 =>
      (length ps1 == length ps2)
      && all (map typePairEquals (zip ps1 ps2))
      && typeEquals ret1 ret2;
    RecordType, RecordType =>
      true;
    _, _ =>
      false;
  };

# env :: [[Binding]]
let emptyEnv = [[]];

# push :: [[Binding]] -> [[Binding]]
let push env =
  append env emptyEnv;

# local :: [[Binding]] -> [String]
let local env =
  map (fn binding => binding.name) (last env);

# addBinding :: [[Binding]] -> Binding -> [[Binding]]
let addBinding env binding =
  let newInnermost = append (last env) [binding]
    in
  append (init env) [newInnermost]; 

# lookupScope :: [Binding] -> String -> Option Type
let lookupScope scope name =
  match scope {
    [] =>
      None;
    binding :: rest =>
      if binding.name == name then
        Some binding.typ
      else
        lookupScope rest name;
  };

# lookup :: [[Binding]] -> String -> Option Type
let lookup env name =
  lookupScope (last env) name;

type Op
  = NegateOp
  | NotOp
  | AddOp
  | SubOp
  | MulOp
  | DivOp
  | ConcatOp
  | LtOp
  | LteOp
  | GtOp
  | GteOp
  | EqOp
  | NotEqOp
  | AndOp
  | OrOp;

type alias FieldExpr =
  {name: String, expr: Expr};
  
type Expr
  = NumberExpr Float
  | BoolExpr Bool
  | StringExpr String
  | NullExpr
  | VarExpr String
  | AssignExpr String Expr
  | BinExpr Op Expr Expr
  | UnaryExpr Op Expr
  | FnExpr [Binding] Type Expr
  | AppExpr Expr Expr
  | RecordExpr [FieldExpr]
  | FieldAccessExpr Expr String;

let isWellFormedType typ =
  match typ {
    NumberType => true;
    BoolType => true;
    StringType => true;
    NullType => true;
    FnType params ret =>
      all (map isWellFormedType params) && isWellFormedType typ;
    RecordType fields =>
      isDistinct (map (fn binding => binding.name) fields)
      && all (map isWellFormedType (map (fn binding => binding.typ) fields));
  };

let addParams env params =
  let newEnv = push env
    in
  let loop ps resEnv =
    match ps {
      [] =>
        resEnv;
      bind :: rest =>
        loop rest (addBinding resEnv bind);
    }
    in
  loop params newEnv;

# collectTypes :: [Option Type] -> Option [Type]
let collectTypes xs =
  match xs {
    [] =>
      Some [];
    Some t :: rest =>
      match collectTypes rest {
        Some ts => Some (t :: ts);
        None => None;
      };
    None :: rest =>
      None;
  };

# buildFieldTypes :: [String] -> [Type] -> [FieldType]
let buildFieldTypes names types =
  let loop pairs =
    match pairs {
      [] =>
        [];
      x :: rest =>
        let name :: typ :: _ = x
          in
        { name = name, typ = typ } :: loop rest;
    }
    in
  loop (zip names types);

# typeOf :: Expr -> [[Binding]] -> Option Type 
let typeOf expr env =
  match expr {
    NumberExpr _ =>
      Some NumberType;
    BoolExpr _ =>
      Some BoolType;
    StringExpr _ =>
      Some StringType;
    NullExpr =>
      Some NullType;
    VarExpr name =>
      lookup env name;
    AssignExpr name e =>
      match lookup env name, typeOf e env {
        Some t1, Some t2 =>
          if typeEquals t1 t2 then
            Some t1
          else
            None;
        _, _ =>
          None;
      };
    UnaryExpr op e =>
      match op, typeOf e env {
        NegateOp, NumberType =>
          Some NumberType;
        NotOp, BoolType =>
          Some BoolType;
        _, _ =>
          None;
      };
    BinExpr op e1 e2 =>
      match op, typeOf e1 env, typeOf e2 env {
        AddOp, NumberType, NumberType =>
          Some NumberType;
        SubOp, NumberType, NumberType =>
          Some NumberType;
        MulOp, NumberType, NumberType =>
          Some NumberType;
        DivOp, NumberType, NumberType =>
          Some NumberType;
        ConcatOp, StringType, StringType =>
          Some StringType;
        LtOp, NumberType, NumberType =>
          Some NumberType;
        LteOp, NumberType, NumberType =>
          Some NumberType;
        GtOp, NumberType, NumberType =>
          Some NumberType;
        GteOp, NumberType, NumberType =>
          Some BoolType;
        EqOp, NumberType, NumberType =>
          Some BoolType;
        EqOp, BoolType, BoolType =>
          Some BoolType;
        EqOp, StringType, StringType =>
          Some BoolType;
        EqOp, NullType, NullType =>
          Some BoolType;
        NotEqOp, NumberType, NumberType =>
          Some BoolType;
        NotEqOp, BoolType, BoolType =>
          Some BoolType;
        NotEqOp, StringType, StringType =>
          Some BoolType;
        NotEqOp, NullType, NullType =>
          Some BoolType;
        AndOp, BoolType, BoolType =>
          Some BoolType;
        OrOp, BoolType, BoolType =>
          Some BoolType;
        _, _, _ =>
          None;
      };
      FnExpr params returnType body =>
        let distinct = isDistinct (map (fn binding => binding.name) params)
          in
        let paramTypes = map (fn binding => binding.typ) params
          in
        let wellFormed = all (map isWellFormedType paramTypes) && isWellFormedType returnType
          in
        if distinct && wellFormed then
          let newEnv = addParams env params
            in
          match typeOf body newEnv {
            Some bodyType =>
              if typeEquals bodyType returnType then
                Some (FnType paramTypes returnType)
              else
                None;
            None =>
              None;
          }
        else
          None;
      AppExpr function args =>
        match typeOf function env {
          Some (FnType paramTypes returnType) =>
            let argSomeTypes = map (fn arg => typeOf arg env) args
              in
            let hasNone =
              any (
                map
                  (fn v =>
                    match v {
                      None => true;
                      Some _ => false;
                    })
                  argSomeTypes
              )
              in
            if (length args != length paramTypes) || hasNone then
              None
            else
              let argTypes =
                map
                  (fn v =>
                    match v {
                      Some t => t;
                      _ => NumberType; # unreachable fallback; see note below
                    })
                  argSomeTypes
                in
              let matches =
                all (
                  map
                    (fn pair => typeEquals (fst pair) (last pair))
                    (zip paramTypes argTypes)
                )
                in
              if matches then
                Some returnType
              else
                None;
          _ =>
            None;
        };
      RecordExpr fields =>
        let fieldNames = map (fn f => f.name) fields
          in
        if not (isDistinct fieldNames) then
          None
        else
          let fieldTypes = collectTypes (map (fn f => typeOf f.expr env) fields)
            in
          # let _ = outputLn(show(fieldTypes)) in
          match fieldTypes {
            Some types =>
              if length types != length fieldNames then
                None
              else
                Some (RecordType (buildFieldTypes fieldNames types));
            None =>
              None;
          };
      FieldAccessExpr expr name =>
        match typeOf expr env {
          Some (RecordType fieldTypes) =>
            let loop fields =
              match fields {
                [] =>
                  None;
                field :: rest =>
                  if field.name == name then
                    Some field.typ
                  else
                    loop rest;
              }
              in
            loop fieldTypes;
          _ =>
            None;
        };
      _ => 
        None;
  };

