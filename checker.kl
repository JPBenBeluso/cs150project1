include "common.kl";
include "syntax.kl";

# typePairEquals :: [Type] -> Bool
let typePairEquals pair =
  # pair is a tuple [Type, Type]
  typeEquals (fst pair) (last pair);

# typeEquals :: Type -> Type -> Bool
let typeEquals left right =
  match left, right {
    NumberType, NumberType =>
      true;
    BoolType, BoolType =>
      true;
    StringType, StringType =>
      true;
    NullType, NullType =>
      true;
    FnType ps1 ret1, FnType ps2 ret2 =>
      (length ps1 == length ps2)
      && all (map typePairEquals (zip ps1 ps2))
      && typeEquals ret1 ret2;
    RecordType, RecordType =>
      true;
    _, _ =>
      false;
  };

# env :: TypeEnv
let emptyEnv = [[]];

# push :: TypeEnv -> TypeEnv
let push env =
  append env emptyEnv;

# local :: TypeEnv -> [String]
let local env =
  map (fn binding => binding.name) (last env);

# addBinding :: TypeEnv -> Binding -> TypeEnv
let addBinding env binding =
  let newInnermost = append (last env) [binding]
    in
  append (init env) [newInnermost]; 

# lookupScope :: [Binding] -> String -> Option Type
let lookupScope scope name =
  match scope {
    [] =>
      None;
    binding :: rest =>
      if binding.name == name then
        Some binding.typ
      else
        lookupScope rest name;
  };

# lookup :: TypeEnv -> String -> Option Type
let lookup env name =
  lookupScope (last env) name;

let isWellFormedType typ =
  match typ {
    NumberType => true;
    BoolType => true;
    StringType => true;
    NullType => true;
    FnType params ret =>
      all (map isWellFormedType params) && isWellFormedType typ;
    RecordType fields =>
      isDistinct (map (fn binding => binding.name) fields)
      && all (map isWellFormedType (map (fn binding => binding.typ) fields));
  };

# addParams :: TypeEnv -> [Binding] -> TypeEnv
let addParams env params =
  let newEnv = push env
    in
  let loop ps resEnv =
    match ps {
      [] =>
        resEnv;
      bind :: rest =>
        loop rest (addBinding resEnv bind);
    }
    in
  loop params newEnv;

# buildFieldTypes :: [String] -> [Type] -> [FieldType]
let buildFieldTypes names types =
  let loop pairs =
    match pairs {
      [] =>
        [];
      x :: rest =>
        let name :: typ :: _ = x
          in
        { name = name, typ = typ } :: loop rest;
    }
    in
  loop (zip names types);

# collectResults :: [Result a e] -> Result [a] e
# Result version of collectTypes: first Error wins, otherwise all values in order.
let collectResults results =
  match results {
    [] =>
      Ok [];
    r :: rest =>
      match r {
        Error err =>
          Error err;
        Ok v =>
          match collectResults rest {
            Error err =>
              Error err;
            Ok vs =>
              Ok (v :: vs);
          };
      };
  };

# checkExpr :: Expr -> TypeEnv -> Result Type TypeError
let checkExpr expr env =
  match expr {
    NumberExpr _ =>
      Ok NumberType;
    BoolExpr _ =>
      Ok BoolType;
    StringExpr _ =>
      Ok StringType;
    NullExpr =>
      Ok NullType;
    VarExpr name =>
      match lookup env name {
        Some t =>
          Ok t;
        None =>
          Error UnboundVariable;
      };
    AssignExpr name e =>
      match lookup env name {
        None =>
          Error UnboundVariable;
        Some t1 =>
          match checkExpr e env {
            Error err =>
              Error err;
            Ok t2 =>
              if typeEquals t1 t2 then
                Ok t1
              else
                Error TypeMismatch;
          };
      };
    UnaryExpr op e =>
      match checkExpr e env {
        Error err =>
          Error err;
        Ok t =>
          match op, t {
            NegateOp, NumberType =>
              Ok NumberType;
            NotOp, BoolType =>
              Ok BoolType;
            _, _ =>
              Error InvalidOperands;
          };
      };
    BinExpr op e1 e2 =>
      match checkExpr e1 env {
        Error err =>
          Error err;
        Ok t1 =>
          match checkExpr e2 env {
            Error err =>
              Error err;
            Ok t2 =>
              match op, t1, t2 {
                AddOp, NumberType, NumberType =>
                  Ok NumberType;
                SubOp, NumberType, NumberType =>
                  Ok NumberType;
                MulOp, NumberType, NumberType =>
                  Ok NumberType;
                DivOp, NumberType, NumberType =>
                  Ok NumberType;
                ConcatOp, StringType, StringType =>
                  Ok StringType;
                LtOp, NumberType, NumberType =>
                  Ok NumberType;
                LteOp, NumberType, NumberType =>
                  Ok NumberType;
                GtOp, NumberType, NumberType =>
                  Ok NumberType;
                GteOp, NumberType, NumberType =>
                  Ok BoolType;
                EqOp, NumberType, NumberType =>
                  Ok BoolType;
                EqOp, BoolType, BoolType =>
                  Ok BoolType;
                EqOp, StringType, StringType =>
                  Ok BoolType;
                EqOp, NullType, NullType =>
                  Ok BoolType;
                NotEqOp, NumberType, NumberType =>
                  Ok BoolType;
                NotEqOp, BoolType, BoolType =>
                  Ok BoolType;
                NotEqOp, StringType, StringType =>
                  Ok BoolType;
                NotEqOp, NullType, NullType =>
                  Ok BoolType;
                AndOp, BoolType, BoolType =>
                  Ok BoolType;
                OrOp, BoolType, BoolType =>
                  Ok BoolType;
                _, _, _ =>
                  Error InvalidOperands;
              };
          };
      };
    FnExpr params returnType body =>
      let distinct = isDistinct (map (fn binding => binding.name) params)
        in
      let paramTypes = map (fn binding => binding.typ) params
        in
      let wellFormed = all (map isWellFormedType paramTypes) && isWellFormedType returnType
        in
      if not distinct then
        Error DuplicateParameter
      else if not wellFormed then
        Error IllFormedType
      else
        let newEnv = addParams env params
          in
        match checkExpr body newEnv {
          Ok bodyType =>
            if typeEquals bodyType returnType then
              Ok (FnType paramTypes returnType)
            else
              Error TypeMismatch;
          Error err =>
            Error err;
        };
    AppExpr function args =>
      match checkExpr function env {
        Ok (FnType paramTypes returnType) =>
          match collectResults (map (fn arg => checkExpr arg env) args) {
            Error err =>
              Error err;
            Ok argTypes =>
              if length args != length paramTypes then
                Error ArityMismatch
              else
                let matches =
                  all (
                    map
                      (fn pair => typeEquals (fst pair) (last pair))
                      (zip paramTypes argTypes)
                  )
                  in
                if matches then
                  Ok returnType
                else
                  Error TypeMismatch;
          };
        Ok _ =>
          Error NotAFunction;
        Error err =>
          Error err;
      };
    RecordExpr fields =>
      let fieldNames = map (fn f => f.name) fields
        in
      if not (isDistinct fieldNames) then
        Error DuplicateField
      else
        match collectResults (map (fn f => checkExpr f.expr env) fields) {
          Ok types =>
            if length types != length fieldNames then
              Error RecordShapeMismatch
            else
              Ok (RecordType (buildFieldTypes fieldNames types));
          Error err =>
            Error err;
        };
    FieldAccessExpr expr name =>
      match checkExpr expr env {
        Ok (RecordType fieldTypes) =>
          let loop fields =
            match fields {
              [] =>
                Error UnknownField;
              field :: rest =>
                if field.name == name then
                  Ok field.typ
                else
                  loop rest;
            }
            in
          loop fieldTypes;
        Ok _ =>
          Error NotARecord;
        Error err =>
          Error err;
      };
    _ =>
      Error UnsupportedExpression;
  };

# checkStmt :: Stmt -> TypeEnv -> Result TypeEnv TypeError
let checkStmt stmt env =
  match stmt {
    LetStmt name None expr =>
      match checkExpr expr env {
        Ok t =>
          if isIn (local env) name then
            Error DuplicateDeclaration
          else
            Ok (addBinding env {name = name, typ = t});
        Error err =>
          Error err;
      };
    LetStmt name (Some t_ann) expr =>
      match checkExpr expr env {
        Ok t_exp =>
          if isIn (local env) name then
            Error DuplicateDeclaration
          else if not (typeEquals t_ann t_exp) then
            Error TypeMismatch
          else
            Ok (addBinding env {name = name, typ = t_ann});
        Error err =>
          Error err;
      };
    ExprStmt expr =>
      match checkExpr expr env {
        Ok _ =>
          Ok env;
        Error err =>
          Error err;
      };
    BlockStmt stmts =>
      match checkSeq stmts (push env) {
        Ok _ =>
          Ok env;
        Error err =>
          Error err;
      };
    IfStmt cond yes (Some no) =>
      # cond : expr; yes, no : blocks
      match checkExpr cond env {
        Ok BoolType =>
          match checkStmt yes env, checkStmt no env {
            Ok env_1, Ok env_2 =>
              Ok env;
            Error err, _ =>
              Error err;
            _, Error err =>
              Error err;
          };
        Ok _ =>
          Error ConditionNotBool;
        Error err =>
          Error err;
      };
    IfStmt cond yes None =>
      match checkExpr cond env {
        Ok BoolType =>
          match checkStmt yes env {
            Ok env_1 =>
              Ok env;
            Error err =>
              Error err;
          };
        Ok _ =>
          Error ConditionNotBool;
        Error err =>
          Error err;
      };
    WhileStmt cond block =>
      match checkExpr cond env {
        Ok BoolType =>
          match checkStmt block env {
            Ok env_1 =>
              Ok env;
            Error err =>
              Error err;
          };
        Ok _ =>
          Error ConditionNotBool;
        Error err =>
          Error err;
      };
    _ =>
      Error UnsupportedStatement;
  };

# checkSeq :: [Stmt] -> TypeEnv -> Result TypeEnv TypeError
let checkSeq stmts env =
  match stmts {
    [] =>
      Ok env;
    stmt :: rest =>
      match checkStmt stmt env {
        Ok env_1 =>
          checkSeq rest env_1;
        Error err =>
          Error err;
      };
  };

# checkProgram :: Program -> Result Unit TypeError
let checkProgram program =
  match program {
    Program stmts =>
      match checkSeq stmts [[]] {
        Ok _ =>
          Ok unit;
        Error err =>
          Error err;
      };
  };
